{
  "name": "knazawy-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Karam Restaurant Platform — airline catering, inventory, finance, and hotel coordination.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm --filter @knazawy/shared build && pnpm -r --filter ./packages/* --filter ./apps/* build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @knazawy/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @knazawy/shared build && pnpm -r --parallel --filter @knazawy/web --filter @knazawy/portal --filter @knazawy/api dev",
    "dev:api": "pnpm --filter @knazawy/api dev",
    "dev:web": "pnpm --filter @knazawy/web dev",
    "dev:portal": "pnpm --filter @knazawy/portal dev",
    "seed:local": "pnpm --filter @knazawy/api seed:local",
    "seed:demo": "pnpm --filter @knazawy/shared build && pnpm --filter @knazawy/api seed:demo",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
