# Copy to .env at the repo root. Never commit .env.
NODE_ENV=development

# API
PORT_API=3001
DATABASE_URL=postgresql://knazawy:knazawy@localhost:5432/knazawy?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-in-local-only

# Local dev admin created by `pnpm seed:local`. Refuses to run when NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@karam.local
SEED_ADMIN_PASSWORD=1234

# Browser origins allowed to call the API.
WEB_BASE_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3002
API_BASE_URL=http://localhost:3001

# Optional comma-separated origins for a phone on the same Wi-Fi. Leave empty in production.
LOCAL_NETWORK_BASE_URLS=
